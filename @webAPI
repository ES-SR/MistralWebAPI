#!/usr/bin/env zsh
#autoload
emulate -LR zsh -o extendedglob -o typesetsilent -o shortloops -o aliases

(( ! ${+functions[__@args:parse]} )) && {
	local ArgParserURL='https://raw.githubusercontent.com/ES-SR/ZshTools/refs/heads/main/%40/args/%40args%3Aparse.zsh'
	. <(2>/dev/null curl -fsSL "${ArgParserURL}" --)
	. "${${(%):-%x}:A}" "${(@)argv}"
	return
}

function @webAPI {
	emulate -LR zsh -o extendedglob -o typesetsilent -o shortloops -o aliases
	{
		local ScriptRoot="${${(%):-%x}:A:h}"
		[[ -f "${ScriptRoot}/@/webAPI/env/__@webAPI:env.zsh" ]] || ScriptRoot="${PWD}"
		(( ${+functions[__@webAPI:paths:resolve]} )) || . "${ScriptRoot}/@/webAPI/env/__@webAPI:env.zsh"

		local -A WebAPIPaths=()
		local -A ServerArgs=()
		local -a RemainingArgv=()

		local -a CommandNames=(
			Help
			Server
			Template
			Events
			Info
		)
		local -a CommandPatterns=(
			Help
			Server
			Template
			Events
			Info
		)

		local -a ConfigNames=(
			HostAddress
			Port
			ConfigurationFile
			Directory
		)
		local -a ConfigPatterns=(
			HostAddr.ess
			Port
			Conf.ig.uration.File
			Dir.ectory
		)

		local -a SpecNames=( "${(@)CommandNames}" "${(@)ConfigNames}" )
		local -a SpecPatterns=( "${(@)CommandPatterns}" "${(@)ConfigPatterns}" )

		local -A HelpInfo=(
			Help              ";Show this help message;@webAPI Help, @webAPI -h, @webAPI --help"
			Server            "<run|stop|status|update|configure>;Manage the WebAPI server process and configuration;@webAPI server run -p 8080, @webAPI:server status"
			Template          "<new|load|edit|remove|list> ...;Manage and load saved form/operation templates;@webAPI template new chat mistral:chat model=mistral-large, @webAPI:template list"
			Events            "<read|queueSize|clear|pause|resume|start|stop>;Read and manage buffered SSE bridge events;@webAPI events read 5, @webAPI:events queueSize 200"
			Info              ";Inspect connected browser UI clients, active provider/op, and state;@webAPI Info, @webAPI -i, @webAPI --info"
			HostAddress       "<addr>;Bind address override for server (default: 127.0.0.1);-ha 10.0.0.1, --host-address 0.0.0.0, hostAddr=192.168.1.50"
			Port              "<0-65535>;Port override for server (default: 3000);-p 8080, --port 5200, Port=9000"
			ConfigurationFile "<path>;Path to config file (default: ./webAPI.conf);-cf ./custom.conf, --config-file prod.conf, ConfigFile=./test.conf"
			Directory         "<path>;Repository directory override;-d /path/to/repo, --directory ~/webAPI"
		)

		function __@webAPI:help {
			. "${ScriptRoot}/@/webAPI/help/__@webAPI:help.zsh"
			__@webAPI:help
		}

		function __@webAPI:json:escape {
			local Str="${1}"
			Str="${Str//\\/\\\\}"
			Str="${Str//\"/\\\"}"
			Str="${Str//$'\n'/\\n}"
			Str="${Str//$'\r'/\\r}"
			Str="${Str//$'\t'/\\t}"
			Str="${Str//$'\b'/\\b}"
			Str="${Str//$'\f'/\\f}"
			print -rn -- "${Str}"
		}

		function __@webAPI:bridge:params {
			local -a Pairs=()
			local Item Key Val EscKey EscVal
			for Item ( "${(@)argv}" ) {
				[[ "${Item}" == *"="* ]] && {
					Key="${Item%%=*}"
					Val="${Item#*=}"
					EscKey="$(__@webAPI:json:escape "${Key}")"
					[[ "${Val}" == (true|false|null|(-|)<->(.<->|)) ]] && {
						Pairs+=( "\"${EscKey}\":${Val}" )
					} || {
						EscVal="$(__@webAPI:json:escape "${Val}")"
						Pairs+=( "\"${EscKey}\":\"${EscVal}\"" )
					}
				}
			}
			print -r -- "{${(j.,.)Pairs}}"
		}

		function __@webAPI:server {
			. "${ScriptRoot}/@/webAPI/server/@webAPI:server.zsh"
			@webAPI:server "${(@)argv}"
		}

		function __@webAPI:template {
			. "${ScriptRoot}/@/webAPI/template/@webAPI:template.zsh"
			@webAPI:template "${(@)argv}"
		}

		function __@webAPI:events {
			. "${ScriptRoot}/@/webAPI/events/@webAPI:events.zsh"
			@webAPI:events "${(@)argv}"
		}

		function __@webAPI:info {
			local BridgeURL="http://${ServerArgs[HostAddress]}:${ServerArgs[Port]}"
			curl -fsSL "${BridgeURL}/bridge/state"
			print ""
		}

		function __@webAPI:send {
			local BridgeURL="http://${ServerArgs[HostAddress]}:${ServerArgs[Port]}"
			local TargetProv="" TargetOp=""
			local -a ParamArgs=()
			local -a InputArgs=( "${(@)argv}" )

			# Check if first non-assignment argument is a saved template name
			(( ${#InputArgs} )) && [[ "${InputArgs[1]}" != *"="* ]] && {
				local TplFile="${WebAPIPaths[TemplatesDir]}/${InputArgs[1]}.conf"
				[[ -f "${TplFile}" ]] && {
					local Line
					for Line ( "${(@f)$(<"${TplFile}")}" ) {
						[[ -z "${Line}" || "${Line}" == "#"* ]] && continue
						[[ "${Line}" == Target=* ]] && {
							local Tgt="${Line#Target=}"
							[[ "${Tgt}" == *":"* ]] && {
								TargetProv="${Tgt%%:*}"
								TargetOp="${Tgt#*:}"
							} || {
								TargetOp="${Tgt}"
							}
						} || {
							ParamArgs+=( "${Line}" )
						}
					}
					InputArgs=( "${(@)InputArgs[2,-1]}" )
				} || {
					[[ "${InputArgs[1]}" == *":"* ]] && {
						TargetProv="${InputArgs[1]%%:*}"
						TargetOp="${InputArgs[1]#*:}"
					} || {
						TargetOp="${InputArgs[1]}"
					}
					InputArgs=( "${(@)InputArgs[2,-1]}" )
				}
			}
			ParamArgs+=( "${(@)InputArgs}" )

			local ParamsJson="$(__@webAPI:bridge:params "${(@)ParamArgs}")"
			local Payload="{\"action\":\"execute\",\"wait\":true,\"provider\":\"${TargetProv}\",\"operation\":\"${TargetOp}\",\"params\":${ParamsJson}}"
			curl -fsSL -X POST -H "Content-Type: application/json" -d "${Payload}" "${BridgeURL}/bridge/command"
			print ""
		}

		(( ARGC )) || {
			__@webAPI:help
			return 0
		}

		__@webAPI:paths:resolve
		__@webAPI:config:resolve "${(@)argv}"

		local -a CommandSpecs=(
			Help
			Server
			Template
			Events
			Info
			Dir.ectory:1
		)
		set -- "${(@)RemainingArgv}"
		@args:parse "${(@)CommandSpecs}"

		(( Help )) && {
			__@webAPI:help
			return 0
		}

		local -i ExitCode=0 Dispatched=0
		local S
		for S ( ${CommandNames} ) {
			local Vals=( ${(P)S} )
			(( ${#Vals[1]/0/} )) && {
				Dispatched=1
				local Cmd="__@webAPI${S//(#m)[A-Z]/:${(L)MATCH}}"
				$Cmd "${(@)Argv}" || ExitCode=$?
			}
		}

		(( Dispatched )) || {
			__@webAPI:send "${(@)Argv}" || ExitCode=$?
		}
		return ${ExitCode}
	} always {
		local S
		for S ( ${CommandNames} ) {
			unfunction "__@webAPI${S//(#m)[A-Z]/:${(L)MATCH}}" 2>/dev/null
		}
		unfunction \
			__@webAPI:json:escape \
			__@webAPI:bridge:params \
			__@webAPI:send \
			2>/dev/null
	}
}

@webAPI "${(@)argv}"
